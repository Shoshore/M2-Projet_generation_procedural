{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++ build and run",
            "type": "shell",
            "command": " cd code && rm -rf build && mkdir build && cd build && cmake .. && cd .. && cmake --build build && ./orometrie ",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        }
    ]
}